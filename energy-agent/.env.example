# JanUrja Energy Intelligence Agent Environment Configuration
# Copy this file to .env and configure your GEMINI_API_KEY.
# DO NOT commit .env with real secrets to version control.

# Google Gemini API key (Required for live Gemini LLM agent reasoning)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model ID (Defaults to gemini-3.8-flash)
GEMINI_MODEL_ID=gemini-3.8-flash

# Model Temperature (0.0 to 1.0, lower = more deterministic)
MODEL_TEMPERATURE=0.2

# Server Port and Host
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Simulation Notice
SIMULATION_MODE=true
